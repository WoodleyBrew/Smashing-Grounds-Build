<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<app version="1.0">
	<name>SG Alt USB Loader</name>
	<version>70r78.13</version>
	<coder>Project+ Dev Team, Iris Flower</coder>
	<release_date>20250501180000</release_date>
	<short_description>Use if SG Launcher fails</short_description>
	<long_description>
Use this if you have problems with the main SG Launcher. If this doesn't work please look in the SG 3.2.X.txt file to see instructions on how to install cIOS on the Wii, or just ping Iris</long_description>
	<arguments>
		<arg>#RSBE01</arg>
		<arg>intro = 0</arg>
		<arg>device = usb</arg>
		<arg>partition = auto</arg>
		<arg>ios = 249</arg>
		<arg>private_server = 2</arg>
		<arg>deflicker = 0</arg>
		<arg>fix_480p = 1</arg>
		<arg>video = auto</arg>
		<arg>video_patch = all</arg>
		<arg>ocarina = 1</arg>
		<arg>hooktype = axframe</arg>
		<arg>codes_path = sd:/project+</arg>
	</arguments>
	<ahb_access/>

</app>
